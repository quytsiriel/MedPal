# FPT AI Factory - Ollama LLM Endpoint (Brain 1 - Router/Diagnosis)
OLLAMA_BASE_URL=http://<server-ip>:11434/v1
OLLAMA_MODEL=medgemma-27b-it:q4_0

# FPT AI Factory - Ollama LLM Endpoint (Brain 2 - Evaluation)
OLLAMA_BASE_URL_2=http://<server-ip>:11435/v1
OLLAMA_MODEL_2=medgemma-27b-it:q4_0

# FPT AI Factory - Ollama LLM Endpoint (Brain 3 - Advice Generation)
OLLAMA_BASE_URL_3=http://<server-ip>:11436/v1
OLLAMA_MODEL_3=medgemma-27b-it:q4_0

# FPT AI Factory - Ollama LLM Endpoint (Brain 4 - OCR Vision)
OLLAMA_BASE_URL_4=http://<server-ip>:11437/v1
OLLAMA_MODEL_4=gemma3:27b

# FPT Cloud Whisper STT
FPT_WHISPER_API_KEY=your_fpt_whisper_api_key_here
FPT_WHISPER_MODEL=FPT.AI-whisper-medium

# Firebase Configuration
FIREBASE_PROJECT_ID=medpal-dev
# GOOGLE_APPLICATION_CREDENTIALS=d:\path\to\firebase-sa.json

# Google Gemini API (Dành cho OCR hoặc dự phòng)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps API Key (Dành cho Mobile app)
MAPS_API_KEY=your_maps_api_key_here
