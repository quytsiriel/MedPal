# .env.example - Copy thành .env và điền giá trị thật

# FPT AI Factory - Ollama LLM Endpoint (Sử dụng thay cho Gemini)
OLLAMA_BASE_URL=http://<server-ip>:11434/v1
OLLAMA_MODEL=<model-name-from-ollama-list>

# Firebase
FIREBASE_PROJECT_ID=medpal-dev
FIREBASE_SERVICE_ACCOUNT_PATH=/secrets/firebase-service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=d:\path\to\firebase-sa.json

# Google AI (Cũ - Giữ lại nếu cần)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps
MAPS_API_KEY=your_maps_api_key_here

# Google Cloud
GOOGLE_CLOUD_PROJECT=medpal-dev
GOOGLE_CLOUD_REGION=asia-southeast1

# Cloud Run (điền sau khi deploy)
CLOUD_RUN_URL=https://medpal-backend-xxxx-as.a.run.app
